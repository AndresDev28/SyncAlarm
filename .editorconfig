# EditorConfig baseline for SyncAlarm.
# See https://editorconfig.org for the spec.
#
# The `[*.{kt,kts,java}]` section is the project's contract for Kotlin and
# Kotlin-DSL files (Kotlin sources, Gradle build scripts) and Java sources
# (Hilt-generated Java is checked into `app/build/generated/hilt/` — the
# baseline applies there too). Other file types use sensible defaults below.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts,java}]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
